        }
      }
    },
    "The transcription engine wasn’t ready." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Transkriptionsengine war nicht bereit."
          }
        }
      }
    },
    "These words are fed to the speech model so it favours them over similar-sounding ones." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Wörter werden an das Sprachmodell übergeben, damit es sie ähnlich klingenden Wörtern vorzieht."
          }
        }
      }
    },
    "They appear once you have dictated something." : {
