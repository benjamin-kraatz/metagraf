    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metagraf hört nur während eines Diktats über das Mikrofon zu, um deine Sprache auf diesem Gerät in Text umzuwandeln."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metagraf listens only while you dictate, so it can turn your speech into text on this device."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "comment" : "Privacy - Speech Recognition Usage Description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metagraf transkribiert deine Sprache vollständig auf diesem Gerät. Nichts wird an einen Server gesendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metagraf transcribes your speech entirely on this device. Nothing is sent to a server."
          }
        }
      }
